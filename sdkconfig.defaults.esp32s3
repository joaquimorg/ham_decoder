# ESP32-S3 N16R8: 16 MB quad flash + 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 4 MB app + ~12 MB storage (partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM, mapped into the heap (malloc may return PSRAM for large blocks;
# use heap_caps_malloc(..., MALLOC_CAP_SPIRAM) for explicit placement).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Large buffers marked EXT_RAM_BSS_ATTR (web server, decoders) live in PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Wi-Fi and LWIP buffers in PSRAM too: internal RAM runs out with the LCD
# (the web server task could not be created).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
